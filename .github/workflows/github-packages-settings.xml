<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>
    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>vanillabp-adapter-platform-integration</id>
                    <url>https://maven.pkg.github.com/vanillabp/adapter-platform-integration</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>false</enabled>
                  </releases>
                </repository>
                <repository>
                    <id>vanillabp-spi-for-java</id>
                    <url>https://maven.pkg.github.com/vanillabp/spi-for-java</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>false</enabled>
                  </releases>
                </repository>
                <!-- the MongoDB changeset mechanism, which this repository used to carry itself.
                     Only its snapshots come from here; a release of it goes to Maven Central. -->
                <repository>
                    <id>phactum-mongodb-changesets</id>
                    <url>https://maven.pkg.github.com/Phactum/mongodb-changesets</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <servers>
        <server>
            <id>github</id>
            <username>${env.USER_NAME}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <server>
            <id>vanillabp-adapter-platform-integration</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
        <server>
            <id>vanillabp-spi-for-java</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
        <server>
            <id>phactum-mongodb-changesets</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
    </servers>

</settings>

