<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>
    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <!-- What this build resolves from outside its own reactor, and nothing else. This
                     is not a list of what VanillaBP publishes: every GitHub Packages URL of an
                     account serves every package of that account, so a line here does no work of
                     its own. What it does is say where a dependency is expected to come from, and
                     a line which names nothing claims a dependency which does not exist. Story
                     1376 removed four of those, among them a repository whose name looks like an
                     artifact this build uses and is not.
                     Before adding a line, show that this build resolves a coordinate from it,
                     directly or transitively, and show it with a reactor build against an empty
                     local repository. A green run of the CI cannot show it, because setup-java
                     runs with 'cache: maven' and the artifact may come from the runner's cache. -->
                <!-- everything which is not VanillaBP: Spring Boot, Quarkus, the MongoDB driver, the
                     test libraries, and the release parent of this build -->
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <!-- every io.vanillabp artifact of the platform reactor, which is the integration and
                     extension SPI, the Spring Boot and Quarkus integrations, vanillabp-spring-boot-support,
                     the BPMS doubles and test-utils of the tests here -->
                <repository>
                    <id>vanillabp-adapter-platform-integration</id>
                    <url>https://maven.pkg.github.com/vanillabp/adapter-platform-integration</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>false</enabled>
                  </releases>
                </repository>
                <!-- io.vanillabp:spi-for-java, the SPI an application writes against -->
                <repository>
                    <id>vanillabp-spi-for-java</id>
                    <url>https://maven.pkg.github.com/vanillabp/spi-for-java</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>false</enabled>
                  </releases>
                </repository>
                <!-- the MongoDB changeset mechanism, which this repository used to carry itself.
                     Only its snapshots come from here; a release of it goes to Maven Central. -->
                <repository>
                    <id>phactum-mongodb-changesets</id>
                    <url>https://maven.pkg.github.com/Phactum/mongodb-changesets</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <servers>
        <server>
            <id>github</id>
            <username>${env.USER_NAME}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <server>
            <id>vanillabp-adapter-platform-integration</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
        <server>
            <id>vanillabp-spi-for-java</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
        <server>
            <id>phactum-mongodb-changesets</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
    </servers>

</settings>

