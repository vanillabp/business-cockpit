<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>support-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
  </parent>

  <artifactId>business-cockpit-spring-boot-support</artifactId>
  <name>Business Cockpit support - Spring Boot</name>
  <description>What the Business Cockpit and a workflow module behind it share on Spring Boot: the cockpit's SPI, checking the cockpit's login token, the user and the groups, the exceptions and answers for user tasks, and the REST clients for the APIs of a BPMS, of the cockpit or of any other service.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <properties>
    <!-- an application or an adapter builds against this module, so its snapshot carries a
         javadoc jar as well -->
    <skip.javadoc.jar>false</skip.javadoc.jar>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- the io.vanillabp coordinates this module reads, at the version the root POM names.
          That POM also says why the import is repeated here instead of sitting there. -->
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${version.vanillabp}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      The annotations and interfaces of the cockpit's SPI, and through it the SPI of VanillaBP. Not
      optional: with this module as its only dependency, a workflow module compiles. The cockpit's
      adapter is needed to run the workflow module, so the module's tests take it in test scope.
    -->
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>spi-for-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- the classes which know no platform: the user, the groups, the exceptions of a user task
         and the TLS helpers. They keep their packages, so moving them changed no import. -->
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-support-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The web and security half. It is optional because the application decides which of the two
      it runs: a workflow module which only calls a REST API needs neither, and one which checks
      the cockpit's login token already has both. Nothing here brings MongoDB or Kafka.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <!-- reads and writes the login token: Spring's JWT classes and the Nimbus library under them -->
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      The HTTP interface clients of Spring Framework and the 'spring.http.serviceclient' support of
      Spring Boot, which the package 'rest.httpservice' builds on. The requests are sent by the JDK's
      own HttpClient, so no other HTTP library comes along.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <!-- the size of the connection pool of a group which sends with Apache HttpClient 5. Optional:
           an application which has the library sends with it, and one without it needs no pool
           size, because the JDK's HttpClient has no limit -->
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <!-- the OAuth client credentials grant of an HTTP service group. Optional: only a group with
           'oauth.token-uri' needs it, and the start says so if it is missing -->
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-client</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- the REST client half of 'ClientsConfigurationBase', OpenFeign and OkHttp, which stays for
         the clients built with it -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-beans</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-okhttp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <!--
        Jackson 3 variant, classes are feign.jackson3.Jackson3Decoder/Jackson3Encoder. The version comes
        from the feign-bom imported in the root pom - it has to match feign-core, see the comment there.
      -->
      <artifactId>feign-jackson3</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-slf4j</artifactId>
    </dependency>
    <dependency>
      <!-- part of OpenFeign since 13.x, so the feign-bom keeps it on the version of feign-core -->
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-form</artifactId>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>logging-interceptor</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- LoginTokens, which signs a token the way the core expects it, so a test can show that
           this module and the core accept the same tokens -->
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-support-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the mock request and response the security tests hand to a filter or a repository -->
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- starts a Spring Boot application with HTTP service groups in the tests of 'rest.httpservice' -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- JSON bodies in the tests. An application has Jackson anyway, a client module names it -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the stub server of the HTTP service tests: records each request, answers what the test
           queues, speaks TLS and plays a proxy -->
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-tls</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the generated test client imports these annotations -->
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the output suppression every test class of this module registers -->
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!--
          Generates the client the tests of 'rest.httpservice' call, the way a client module
          generates its own: generator 'spring', library 'spring-http-interface'.
        -->
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.27.0</version>
        <executions>
          <execution>
            <id>inventory-test-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <inputSpec>${project.basedir}/src/test/resources/openapi/inventory.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-http-interface</library>
              <output>${project.build.directory}/generated-test-sources/openapi</output>
              <apiPackage>io.vanillabp.cockpit.support.rest.httpservice.inventory</apiPackage>
              <modelPackage>io.vanillabp.cockpit.support.rest.httpservice.inventory.model</modelPackage>
              <configOptions>
                <useSpringBoot4>true</useSpringBoot4>
                <useJakartaEe>true</useJakartaEe>
                <useTags>true</useTags>
                <openApiNullable>false</openApiNullable>
                <interfaceOnly>true</interfaceOnly>
                <useJspecify>true</useJspecify>
              </configOptions>
              <addCompileSourceRoot>false</addCompileSourceRoot>
              <addTestCompileSourceRoot>true</addTestCompileSourceRoot>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
