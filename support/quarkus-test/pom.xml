<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>support-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
  </parent>

  <artifactId>business-cockpit-quarkus-support-test</artifactId>
  <name>Business Cockpit support - Quarkus, for tests</name>
  <description>What the tests of a Quarkus workflow module need from the Business Cockpit's support: TestLogin, which logs a user with roles in for the calls of a test, the way the login of an application would, so the permission checkers of the module apply.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <properties>
    <!-- a workflow module builds its tests against this module, so its snapshot carries a javadoc
         jar as well -->
    <skip.javadoc.jar>false</skip.javadoc.jar>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- imported first, so it wins over the Spring Boot BOM of the root POM: this module runs
          in the tests of a Quarkus application -->
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${version.quarkus}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      Who the calls of a test run as. Not optional: a workflow module which adds this module in test
      scope gets it with it. It brings the API of Quarkus security, which the module has anyway,
      because only a module with quarkus-security has permission checkers.
    -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Writes META-INF/jandex.idx into the jar, so a test of Quarkus finds TestLogin as a bean,
          the same way it finds the beans of business-cockpit-quarkus-support -->
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
