<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>support-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>business-cockpit-quarkus-support-it</artifactId>
  <name>Business Cockpit support - Quarkus, tested as an application</name>
  <description>A Quarkus application with the Quarkus module of support as a plain dependency. Its tests show that Quarkus finds the check of the login token, the user context, the mappers and the builder of REST clients in that jar on its own, that a form endpoint answers 401, 403, 404 and 409, that a client built from keys fetches its OAuth token, that the route passes the files of a user interface on to an nginx, that TestLogin logs a user in with the permission checkers of the module, and that a login of the module's own works next to the cookie.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <properties>
    <!-- nothing to publish: the module holds tests only. The release build activates source,
         javadoc, gpg and central-publishing through the profiles of io.vanillabp:release-parent,
         and all of them would otherwise sign and upload it. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- the javadoc jar has a skip of its own, and the profile 'release' of the root POM turns it
         off. Set here, it stays on for this module in a release too. -->
    <skip.javadoc.jar>true</skip.javadoc.jar>
    <maven.source.skip>true</maven.source.skip>
    <gpg.skip>true</gpg.skip>
    <skip.central.release>true</skip.central.release>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- imported first, so it wins over the Spring Boot BOM of the root POM: this is a Quarkus
          application -->
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${version.quarkus}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${version.vanillabp}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- the module under test, as a workflow module names it -->
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-quarkus-support</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- the extensions a workflow module with a form brings itself, because support names them
         as optional only -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-security</artifactId>
    </dependency>
    <dependency>
      <!-- the REST client with JSON, which a workflow module brings to call a service -->
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
    <dependency>
      <!-- the proxy an application adds for the route to the nginx of a user interface -->
      <groupId>io.vertx</groupId>
      <artifactId>vertx-http-proxy</artifactId>
    </dependency>
    <dependency>
      <!-- users with passwords in the configuration, for a login of the module's own next to the
        cookie of the cockpit. Without the keys of the test profile which switches it on, it has no
        user and changes nothing. -->
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-elytron-security-properties-file</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- LoginTokens, which signs a token the way the cockpit does -->
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-support-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- TestLogin, which logs a user in for the calls of a test, as a workflow module names it -->
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-quarkus-support-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the service and the OAuth server the client of the tests calls -->
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the output suppression every test class of this module registers -->
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The application boots IN this JVM, and Quarkus logs that boot into a log context of
            its own which the output suppression does not reach. So Surefire writes what a test
            class prints into its report instead of the console, as in support/quarkus. -->
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
            <maven.repo>${settings.localRepository}</maven.repo>
          </systemPropertyVariables>
          <environmentVariables>
            <!-- the secret comes as an environment variable, the way a container gets it. So the
              tests show that the key 'business-cockpit.jwt.hmacSHA256-base64' is found under
              the name Quarkus derives for an environment variable. -->
            <BUSINESS_COCKPIT_JWT_HMACSHA256_BASE64>9kt7o2AC1AF/tV55Txl2MV5cnjtVr6azrL7I2ID0BUw=</BUSINESS_COCKPIT_JWT_HMACSHA256_BASE64>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
