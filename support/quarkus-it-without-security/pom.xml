<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>support-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>business-cockpit-quarkus-support-it-without-security</artifactId>
  <name>Business Cockpit support - Quarkus, tested as an application without quarkus-security</name>
  <description>A Quarkus application with the Quarkus module of support and Quarkus REST, but without quarkus-security, the way a workflow module has it which only throws the exceptions of a user task. Its tests show that such an application builds, starts and answers 401, 404 and 409.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <properties>
    <!-- nothing to publish: the module holds tests only. The release build activates source,
         javadoc, gpg and central-publishing through the profiles of io.vanillabp:release-parent,
         and all of them would otherwise sign and upload it. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- the javadoc jar has a skip of its own, and the profile 'release' of the root POM turns it
         off. Set here, it stays on for this module in a release too. -->
    <skip.javadoc.jar>true</skip.javadoc.jar>
    <maven.source.skip>true</maven.source.skip>
    <gpg.skip>true</gpg.skip>
    <skip.central.release>true</skip.central.release>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- imported first, so it wins over the Spring Boot BOM of the root POM: this is a Quarkus
          application -->
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${version.quarkus}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${version.vanillabp}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- the module under test, as a workflow module names it -->
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-quarkus-support</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- the only extension a workflow module needs for the answers to the exceptions. There is no
         quarkus-security here, and that is what the tests are about. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- QuarkusExtensionTest, which expects a start to fail -->
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-internal</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the output suppression every test class of this module registers -->
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The application boots IN this JVM, and Quarkus logs that boot into a log context of
            its own which the output suppression does not reach. So Surefire writes what a test
            class prints into its report instead of the console, as in support/quarkus. -->
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
            <maven.repo>${settings.localRepository}</maven.repo>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <!-- Quarkus refuses to run a @QuarkusTest and a QuarkusExtensionTest in the same JVM, so
            the test of a start which fails runs in a second execution -->
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/ASecretWithoutQuarkusSecurityIsRefusedTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>a-start-which-fails</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/ASecretWithoutQuarkusSecurityIsRefusedTest.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
