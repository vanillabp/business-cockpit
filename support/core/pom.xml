<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>support-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
  </parent>

  <artifactId>business-cockpit-support-core</artifactId>
  <name>Business Cockpit support - Core</name>
  <description>The part of the Business Cockpit support which knows no platform: the check of the cockpit's login token, the user and the groups, the exceptions of a user task, and the TLS helpers of a REST client. The Spring Boot and the Quarkus module both bring it.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <properties>
    <!-- an application or an adapter builds against this module through the platform modules,
         so its snapshot carries a javadoc jar as well -->
    <skip.javadoc.jar>false</skip.javadoc.jar>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- the io.vanillabp coordinates this module reads, at the version the root POM names.
          That POM also says why the import is repeated here instead of sitting there. -->
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${version.vanillabp}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      Whatever this module brings, a workflow module gets on both platforms, so a library of one
      platform must not slip in. The two below know no platform. Nimbus checks the signature of the
      cockpit's login token, and Spring Security uses the same library under its JWT classes. SLF4J
      is the logging API both platforms route to their own logging.
    -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${version.nimbus-jose-jwt}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the output suppression every test class of this module registers -->
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!--
          The test jar holds what the tests of both platform modules share: LoginTokens, which signs a
          token the way the cockpit does, and a user directory a test can change while it runs. So
          both platforms are tested against the same tokens.
        -->
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-fixtures</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
