<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>extensions-commons-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
  </parent>

  <artifactId>extensions-commons-test-support</artifactId>
  <name>Business Cockpit extension - Commons - Test support</name>
  <description>The cockpit server the tests of every extension repository report to. It is published like the other modules, because the three adapter repositories are repositories of their own and a test classpath cannot read another repository's test classes.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <!-- The classes live in src/main/java although only tests use them: a test classpath cannot
    read another module's test classes, and reading them across repositories is the whole
    reason this module exists. Nothing here is measured for coverage, because a test aid is
    not the code under test. -->

  <properties>
    <!-- the empty agent keeps Surefire's inherited '@{jacoco.agent}' resolvable while JaCoCo is
      off, the way the coverage gate does it -->
    <jacoco.skip>true</jacoco.skip>
    <jacoco.agent/>
  </properties>

  <dependencies>
    <dependency>
      <!-- the free port the server binds comes from here and from nowhere else, so that two
        servers of one build never pick the same one -->
      <!-- The BOM manages this artifact in test scope, which is right for an application: a
        test tool belongs to the test and not to what ships. This module is a library of test
        tools itself, so what it reads from test-utils sits in src/main/java. That is why it
        names its own scope here, and why a later cleanup should leave the line alone. -->
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <!-- the one rule of the cockpit server which does not need a running application is
        checked here, so that it is checked once instead of in every extension repository -->
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- the tests of this module report into the server themselves, so a report is
              either there or it never comes. The long wait is for the repositories whose
              reports travel through an application and a cluster. -->
            <businesscockpit.test-server.wait-millis>1000</businesscockpit.test-server.wait-millis>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
