<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>business-cockpit-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
  </parent>

  <artifactId>extensions-commons-parent</artifactId>
  <packaging>pom</packaging>
  <name>Business Cockpit extension - Commons</name>
  <description>The platform-neutral half of the Business Cockpit extension for VanillaBP Version 2, and the two thin platform modules registering it on Spring Boot and on Quarkus.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <modules>
    <!-- first: the tests of every module below report to the cockpit server it holds -->
    <module>test-support</module>
    <module>core</module>
    <module>spring-boot</module>
    <module>quarkus</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- every io.vanillabp coordinate of this subtree, including the platform's own
          spi-for-java: the cockpit's spi-for-java compiles against the released 1.1.0, and inside
          this subtree the version the Version 2 platform ships wins. The version is the one the
          root POM names, and that POM says why the import is repeated here. -->
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${version.vanillabp}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <!-- An extension depends on the extension SPI alone. It brings the integration SPI
          along, and everything an extension reads from VanillaBP is offered there. This rule
          stops the build of every module below when the core, the adapter SPI or a platform
          integration arrives in a scope the extension's users get, even transitively. Tests may
          still use them in test scope, because nothing of that reaches an application.
          See decision 2 in the repository's DECISIONS.md and the entry which supersedes it in
          part. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>an-extension-depends-on-the-extension-spi-alone</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:compile</exclude>
                    <exclude>io.vanillabp:vanillabp-adapter-spi:*:*:compile</exclude>
                    <exclude>io.vanillabp:vanillabp-spring-boot-integration:*:*:compile</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:compile</exclude>
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:provided</exclude>
                    <exclude>io.vanillabp:vanillabp-adapter-spi:*:*:provided</exclude>
                    <exclude>io.vanillabp:vanillabp-spring-boot-integration:*:*:provided</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:provided</exclude>
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:runtime</exclude>
                    <exclude>io.vanillabp:vanillabp-adapter-spi:*:*:runtime</exclude>
                    <exclude>io.vanillabp:vanillabp-spring-boot-integration:*:*:runtime</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:runtime</exclude>
                  </excludes>
                  <message>The Business Cockpit extension depends on io.vanillabp:vanillabp-extension-spi alone, and on the core, the adapter SPI and the platform integrations in test scope only. Everything an extension reads from VanillaBP is offered by the extension SPI and the integration SPI. See migration-adapter/EXTENSION-AUTHORS.md of vanillabp/adapter-platform-integration, section 1.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
