<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>bpms-api</artifactId>
        <version>0.9.0-SNAPSHOT</version>
    </parent>

    <artifactId>bpms-protobuf-api</artifactId>
    <name>BPMS Protobuf API</name>
    <description>Protobuf classes for efficient transmission of the BPMS events</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          protoc and the protobuf-java runtime move together. protoc 23 wrote classes extending
          GeneratedMessageV3, which protobuf-java 4 marks for removal, and a generated file is the
          last place anybody can fix that. protoc 4.26 and newer write GeneratedMessage instead.
          Generated code also names the version which wrote it and refuses to run on an older
          runtime, so naming a second version here would be a trap.
        -->
        <version.protoc>${version.protobuf}</version.protoc>
        <protoc-jar-maven-plugin.version>3.11.4</protoc-jar-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>

        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.os72</groupId>
                <artifactId>protoc-jar-maven-plugin</artifactId>
                <version>${protoc-jar-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <optimizeCodegen>false</optimizeCodegen>
                            <protocVersion>${version.protoc}</protocVersion>
                            <!--
                              v1.proto imports google/protobuf/timestamp.proto, so the well-known
                              types have to be on the proto path. includeStdTypes reads them from a
                              protoc bundled with the plugin, and the plugin bundles none as new as
                              the one asked for here, which ends the build with a null pointer and
                              no hint. protobuf-java carries the same files, and it is the artifact
                              the generated code runs on anyway.
                            -->
                            <includeMavenTypes>direct</includeMavenTypes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>VanillaBP</id>
            <organization>Phactum Softwareentwicklung GmbH</organization>
            <organizationUrl>https://www.phactum.at</organizationUrl>
        </developer>
    </developers>
</project>