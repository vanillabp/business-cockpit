<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>business-cockpit-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>bpms-protobuf-api</artifactId>
  <name>BPMS Protobuf API</name>
  <description>Protobuf classes for efficient transmission of the BPMS events</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
          protoc writes the generated classes, and protobuf-java is the runtime they run on. Since
          protobuf 4 a generated class names the protoc which wrote it and refuses to load on an
          older runtime. A newer runtime is fine. So protoc must never be newer than the runtime
          an application has, and that runtime is the one its platform manages, not ours.

          That is why protoc has a version of its own and does not follow version.protobuf, which
          Renovate raises. It stays at or below the lowest protobuf-java a supported platform
          manages, written down in protobuf.lowest-platform-runtime: Quarkus 3.40 manages 4.35.0,
          Spring Boot 4.1 manages 4.34.2 and newer, Spring Boot 4.0 manages none. Raise the floor
          when the oldest platform moves, and protoc only up to it. ProtocIsNotNewerThanThePlatformsTest
          fails the build when protoc is above the floor. renovate.json keeps both values away from
          Renovate.

          protoc 23 wrote classes extending GeneratedMessageV3, which protobuf-java 4 marks for
          removal, and a generated file is the last place anybody can fix that. protoc 4.26 and
          newer write GeneratedMessage instead, so protoc stays at 4.26 or newer.
        -->
    <version.protoc>4.31.1</version.protoc>
    <protobuf.lowest-platform-runtime>4.34.2</protobuf.lowest-platform-runtime>
    <protoc-jar-maven-plugin.version>3.11.4</protoc-jar-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
    </dependency>

    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the output suppression every test class registers. The version is named here and not
        taken from the VanillaBP BOM: importing that BOM would put it into the published POM of
        this small API, which applications on any platform read. -->
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <version>${version.vanillabp}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.os72</groupId>
        <artifactId>protoc-jar-maven-plugin</artifactId>
        <version>${protoc-jar-maven-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <optimizeCodegen>false</optimizeCodegen>
              <protocVersion>${version.protoc}</protocVersion>
              <!--
                              v1.proto imports google/protobuf/timestamp.proto, so the well-known
                              types have to be on the proto path. includeStdTypes reads them from a
                              protoc bundled with the plugin, and the plugin bundles none as new as
                              the one asked for here, which ends the build with a null pointer and
                              no hint. protobuf-java carries the same files, and it is the artifact
                              the generated code runs on anyway.
                            -->
              <includeMavenTypes>direct</includeMavenTypes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <protobuf.lowest-platform-runtime>${protobuf.lowest-platform-runtime}</protobuf.lowest-platform-runtime>
            <protobuf.generated-sources>${project.build.directory}/generated-sources</protobuf.generated-sources>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
