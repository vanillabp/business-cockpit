<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>business-cockpit-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>bpms-api-client</artifactId>
  <name>REST client to access the BPMS API</name>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <properties>
    <!-- an application or an adapter builds against this module, so its snapshot carries a
         javadoc jar as well -->
    <skip.javadoc.jar>false</skip.javadoc.jar>
  </properties>

  <dependencies>
    <!--
      Everything the generated sources import, named one by one. The generator 'java' with the
      library 'native' sends with the JDK's own java.net.http.HttpClient and reads and writes JSON with
      Jackson, so no HTTP library comes along. A client which drags a web framework or an HTTP library
      into every consumer cannot be used from a platform-neutral module. See decision 1 in the
      repository's DECISIONS.md.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.27.0</version>
        <configuration>
          <skipIfSpecIsUnchanged>true</skipIfSpecIsUnchanged>
          <generatorName>java</generatorName>
          <apiPackage>io.vanillabp.cockpit.bpms.api.v1</apiPackage>
          <modelPackage>io.vanillabp.cockpit.bpms.api.v1</modelPackage>
          <invokerPackage>io.vanillabp.cockpit.bpms.api.v1</invokerPackage>
          <generateSupportingFiles>true</generateSupportingFiles>
          <configOptions>
            <!-- openapi-generator 7.x snake-cases enum constants (OPEN_TASKS), 6.x did not (OPENTASKS). The
                 wire values come from the spec either way, but the constant names are part of the
                 published Java API - 'legacy' keeps them as they were. -->
            <enumPropertyNaming>legacy</enumPropertyNaming>
            <!-- openapi-generator 7.x initialises optional containers with an empty collection instead of
                 leaving them null. That would turn absent fields into "{}"/"[]" on the wire, because the
                 ObjectMapper only suppresses nulls - so keep the 6.x behaviour. -->
            <containerDefaultToNull>true</containerDefaultToNull>
            <useTags>true</useTags>
            <interfaceOnly>true</interfaceOnly>
            <ensureUniqueParams>false</ensureUniqueParams>
            <useJakartaEe>true</useJakartaEe>
          </configOptions>
          <!-- the JDK's own HttpClient, so the client brings no HTTP library -->
          <library>native</library>
          <addCompileSourceRoot>true</addCompileSourceRoot>
          <generateApiTests>false</generateApiTests>
          <generateModelTests>false</generateModelTests>
          <!-- one file of our own beside the generated ones: BpmsApiPath, the server path of the
               OpenAPI file, see generator/config.yaml. The generator's own templates stay as they
               are. -->
          <configurationFile>${project.basedir}/generator/config.yaml</configurationFile>
          <templateDirectory>${project.basedir}/generator</templateDirectory>
          <!-- the Java sources the client needs, and none of the build files or documents the
               generator writes for a project of its own -->
          <supportingFilesToGenerate>ApiClient.java,ApiException.java,ApiResponse.java,Configuration.java,Pair.java,RFC3339DateFormat.java,RFC3339InstantDeserializer.java,RFC3339JavaTimeModule.java,BpmsApiPath.java</supportingFilesToGenerate>
        </configuration>
        <executions>
          <execution>
            <id>generate-api-client-v1.1</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../openapi/v1_1.yaml</inputSpec>
              <apiPackage>io.vanillabp.cockpit.bpms.api.v1_1</apiPackage>
              <modelPackage>io.vanillabp.cockpit.bpms.api.v1_1</modelPackage>
              <invokerPackage>io.vanillabp.cockpit.bpms.api.v1_1</invokerPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
