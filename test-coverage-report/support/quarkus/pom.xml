<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>test-coverage-report</artifactId>
    <version>0.9.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>support-quarkus-report</artifactId>
  <packaging>pom</packaging>
  <name>Test coverage report - Business Cockpit support (Quarkus)</name>
  <description>Coverage of what a Quarkus workflow module gets from the Business Cockpit support: the core which knows no platform and the Quarkus module, tested on its own and as the dependency of an application. The Spring Boot module is not listed, so no Spring Boot test counts here. The core appears in this report and in the one of the container, which carries the Spring Boot module.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>business-cockpit-support-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>business-cockpit-quarkus-support</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- holds no code, only the tests of an application which has the Quarkus module as a plain
           dependency. Their execution data counts for the classes of that module. -->
      <groupId>${project.groupId}</groupId>
      <artifactId>business-cockpit-quarkus-support-it</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- the same without quarkus-security, which reaches the code for an application which has
           the support for its exceptions only -->
      <groupId>${project.groupId}</groupId>
      <artifactId>business-cockpit-quarkus-support-it-without-security</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <!-- 'report-aggregate' sums up the '*.exec' files of the modules listed in <dependencies> into one report -->
              <goal>report-aggregate</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <outputDirectory>${project.basedir}/report</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
