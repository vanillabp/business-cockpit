<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>release-parent</artifactId>
    <version>1.3.0</version>
  </parent>

  <groupId>io.vanillabp.businesscockpit</groupId>
  <artifactId>business-cockpit-parent</artifactId>
  <version>0.9.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VanillaBP business cockpit</name>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <!--
    The repository holds the Java side only. No user interface and no npm package lives here.
    See decision 63 in the repository's DECISIONS.md.
  -->
  <modules>
    <module>commons</module>
    <module>apis</module>
    <module>business-cockpit</module>
    <module>container</module>
    <module>development</module>
    <module>spi-for-java</module>
    <module>extensions-commons</module>
    <!-- last: it aggregates and judges what all modules above produced -->
    <module>test-coverage-report</module>
  </modules>

  <scm>
    <connection>scm:git:https://github.com/vanillabp/business-cockpit.git</connection>
    <developerConnection>scm:git:https://github.com/vanillabp/business-cockpit.git</developerConnection>
    <url>https://github.com/vanillabp/business-cockpit/tree/main</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <version.java>21</version.java>
    <!--
      The version of every io.vanillabp artifact this repository reads, named here and imported as
      the VanillaBP BOM by each module which needs one. The import is not in this POM. It was kept
      out while the BOM lived on GitHub Packages: the publish workflow has a step which reads only
      this POM, that step had no credentials for the registry, and it ended with 'Non-resolvable
      import POM' the moment the import sat here. The BOM now comes from the snapshot repository of
      Maven Central, which needs no login, so that reason is gone. Moving the import is a change of
      its own.
    -->
    <version.vanillabp>2.0.0-SNAPSHOT</version.vanillabp>
    <version.mongodb-changesets>1.0.0-SNAPSHOT</version.mongodb-changesets>
    <version.org.mapstruct>1.6.3</version.org.mapstruct>
    <version.protobuf>4.31.1</version.protobuf>
    <!--
      One property for the whole JUnit family, used by the BOM import below and by the Surefire
      plugin, which reads its dependencies outside of dependency management.
    -->
    <version.jupiter>6.1.3</version.jupiter>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- where the build breaks, in PERCENT of covered instructions per measurement,
         enforced by test-coverage-report/coverage-gate. The container number is what its
         suite actually reached on 2026-09-06, 57.25 %, rounded down. A threshold is raised
         as tests arrive and never lowered to make a build green, because a threshold
         lowered once stops saying anything about the code. -->
    <coverage.threshold.application-spring-boot>55</coverage.threshold.application-spring-boot>
    <coverage.threshold.extensions-commons-spring-boot>85</coverage.threshold.extensions-commons-spring-boot>
    <coverage.threshold.extensions-commons-quarkus>85</coverage.threshold.extensions-commons-quarkus>
    <!-- the rule every VanillaBP repository is read against. The gate prints each
         measurement against it on every run but never fails on it, because it marks where
         somebody has to look and not the number a build has to hit today. -->
    <coverage.rule>90</coverage.rule>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!--
          Imported before the other BOMs so it wins, and imported at all because naming the aggregator
          'org.junit.jupiter:junit-jupiter' below does not move JUnit on its own. That artifact carries
          no classes. The API, the engine and the parameterized-test module are coordinates of their
          own, and the Spring Boot BOM manages all three through a junit-bom of its own. Without this
          import the version named below reaches the aggregator and nothing else, and the tests run on
          whatever engine Spring Boot brings.
        -->
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.jupiter}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!--
          Imported before the other BOMs so it wins: Spring Cloud pins the OpenFeign artifacts to 13.6.1,
          and feign-jackson3 - the Jackson 3 codec used in commons - implements feign.codec.JsonDecoder,
          which only exists from feign-core 13.10 on. Mixing the two compiles and unit-tests fine and then
          fails at runtime with NoClassDefFoundError: feign/codec/JsonDecoder as soon as a client is built.
          The BOM keeps every feign artifact on one version.
        -->
        <groupId>io.github.openfeign</groupId>
        <artifactId>feign-bom</artifactId>
        <version>13.17</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>4.1.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <!--
          2025.1.x is the first train built against Spring Boot 4. It pins spring-boot.version to 4.0.7,
          this project runs 4.1.0 - the Boot BOM is imported above, so it wins for everything the two have
          in common. There is no train targeting 4.1 yet; the combination is verified by the gateway proxy
          test recipe rather than by Spring Cloud's own compatibility matrix.
        -->
        <version>2025.1.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!--
          The MongoDB migration this repository used to carry itself, in commons, under
          io.vanillabp.cockpit.commons.mongo.changesets. Its snapshots are read from the GitHub
          Packages of Phactum/mongodb-changesets, which .github/workflows/github-packages-settings.xml
          names. A local build needs the same repository in its own settings.xml, see README.md.
        -->
        <groupId>com.phactum.mongodb</groupId>
        <artifactId>mongodb-changesets</artifactId>
        <version>${version.mongodb-changesets}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${version.org.mapstruct}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${version.protobuf}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${version.protobuf}</version>
      </dependency>
      <dependency>
        <!-- the test scope is what this entry adds: two modules name the aggregator without one.
             The version repeats the property the junit-bom above reads, so the two cannot drift. -->
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${version.jupiter}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <!-- late binding: 'jacoco.agent' is filled per module by jacoco-maven-plugin below in
                 this file, so a module which switches JaCoCo off gets an empty value instead of a
                 dangling reference -->
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.junit.jupiter</groupId>
              <artifactId>junit-jupiter-api</artifactId>
              <version>${version.jupiter}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <!-- must match the spring-boot-dependencies import; this project's parent is release-parent,
               not spring-boot-starter-parent, so the version cannot be inherited -->
          <version>4.1.2</version>
          <configuration>
            <classifier>runnable</classifier>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${version.java}</release>
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${version.org.mapstruct}</version>
              </path>
            </annotationProcessorPaths>
            <compilerArgs>
              <!-- javac is the only javadoc check which reads a package private class. The
                   javadoc plugin of the parent opens what a release publishes, so it starts
                   at protected. Every group is checked here except 'missing': a comment
                   which was never written is a warning, not a broken build. -->
              <arg>-Xdoclint:all,-missing</arg>
              <arg>-Amapstruct.suppressGeneratorTimestamp=true</arg>
              <arg>-Amapstruct.suppressGeneratorVersionInfoComment=true</arg>
              <arg>-Amapstruct.defaultComponentModel=spring</arg>
              <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
              <arg>-Amapstruct.unmappedSourcePolicy=IGNORE</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <executions>
            <!-- the check which every build runs. Everything not set here comes from the
                 parent. -->
            <execution>
              <id>check-javadoc</id>
              <configuration>
                <!-- only the sources written by hand are checked. The OpenAPI generator,
                     protoc, MapStruct and the Quarkus extension processor write their code
                     below 'target', and nobody can add a comment there. That code still goes
                     into the javadoc jar of a release: the jar is built by an execution of
                     its own, and that one reads every source root of the compiler. -->
                <sourcepath>${project.build.sourceDirectory}</sourcepath>
                <additionalOptions combine.children="append">
                  <!-- the code written by hand calls the generated code, so javadoc has to find
                       it. This second source path replaces the one above for looking up a
                       type, and javadoc still documents only the files the line above picked.
                       The plugin offers no other way: it does not put the module's own classes
                       on the class path. -->
                  <additionalOption>--source-path ${project.build.sourceDirectory}${path.separator}${project.build.directory}/generated-sources/openapi${path.separator}${project.build.directory}/generated-sources/annotations</additionalOption>
                </additionalOptions>
                <!-- a warning fails the build. Every comment here was written once, and a
                     warning which passes would park the next gap in a build which looks
                     green. -->
                <failOnWarnings>true</failOnWarnings>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- the same formatter, version and rules as every other VanillaBP repository.
           It runs on every module and fails the build on a violation. Before a commit,
           'mvn spotless:apply' at the root formats everything. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <exclude>**/.github/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <exclude>**/.github/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
              <!-- the same reason, and one more: Jackson writes '1.0' as 1.0 and
                   "1025:1025" as 1025:1025, so a string turns into a number. The OpenAPI
                   specs, the Spring configuration below 'config' and the Docker Compose
                   file carry comments and such values. -->
              <exclude>**/openapi/**/</exclude>
              <exclude>**/src/main/resources/api/**/</exclude>
              <exclude>**/src/main/resources/config/**/</exclude>
              <exclude>**/docker-compose.yaml</exclude>
            </excludes>
            <jackson>
              <yamlFeatures>
                <MINIMIZE_QUOTES>true</MINIMIZE_QUOTES>
                <WRITE_DOC_START_MARKER>false</WRITE_DOC_START_MARKER>
                <INDENT_ARRAYS_WITH_INDICATOR>true</INDENT_ARRAYS_WITH_INDICATOR>
              </yamlFeatures>
            </jackson>
          </yaml>
          <java>
            <eclipse>
              <!-- https://help.eclipse.org/latest/index.jsp?topic=%2Forg.eclipse.jdt.doc.isv%2Freference%2Fapi%2Forg%2Feclipse%2Fjdt%2Fcore%2Fformatter%2FDefaultCodeFormatterConstants.html -->
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
      <!-- the sources jar every build attaches. The release parent binds this plugin
           only in its 'release' profile, and a snapshot is deployed without that profile,
           so a snapshot could go out with no sources and show decompiled code in the IDE
           of everyone who builds against it. It is bound here, at the root, and no longer
           in each module, so a module added later does not have to remember it. Version,
           phase and the rest of the configuration come from the parent. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- declared here and not in pluginManagement, because the modules of
             test-coverage-report have to inherit it to build their aggregated reports -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <sessionId>anonymous-session-id</sessionId>
          <excludes>
            <!-- the GUI API is generated into the business-cockpit module's own target/classes from
                 src/main/resources/api/gui/v1.yaml. What its coverage says is something about the
                 generator, not about this repository. -->
            <exclude>io/vanillabp/cockpit/gui/api/v1/**</exclude>
          </excludes>
          <!-- hands the javaagent parameter to Surefire's '@{jacoco.agent}' -->
          <propertyName>jacoco.agent</propertyName>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
